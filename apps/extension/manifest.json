{
  "manifest_version": 3,
  "name": "Ruvee (development build)",
  "version": "0.0.1",
  "description": "Self-hosted password manager. Development build: synthetic data only.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Ruvee" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" }
    }
  }
}
