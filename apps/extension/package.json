{
  "name": "@ruvee/extension",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "RUVEE_EXTENSION_TEST=1 node scripts/build.mjs",
