<?xml version="1.0" encoding="utf-8"?>
<!--
  Release and every non-debug build: HTTPS only, system certificate authorities only (user-added
  CAs are not trusted), no exceptions. TLS verification is never disabled.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
