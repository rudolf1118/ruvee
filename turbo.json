{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.spec.*", "!e2e/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "env": ["DATABASE_URL", "RUVEE_PG_TOOLS_PREFIX", "RUVEE_PG_TOOLS_HOST"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": ["PLAYWRIGHT_CHANNEL", "CI"],
      "cache": false
    },
    "test:headers": {
      "dependsOn": ["build"],
      "env": ["PLAYWRIGHT_CHANNEL", "CI", "RUVEE_EXPORT_PORT"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    }
  }
}
