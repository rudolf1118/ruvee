# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only placeholder. Never put real credentials in this file.

# --- Local PostgreSQL (docker compose) ---
POSTGRES_USER=ruvee
# Local development placeholder. Change it if you like; keep DATABASE_URL in sync.
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=ruvee
POSTGRES_PORT=5433

# --- API (apps/api) ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# The API's database role. Locally the superuser above (the API logs a warning); in a deployment
# the least-privilege runtime role (docs/guides/database-roles.md, follow-up review F-25).
# ruvee-admin's operator URL (RUVEE_ADMIN_DATABASE_URL) never goes in this file.
DATABASE_URL=postgresql://ruvee:local-dev-only-change-me@127.0.0.1:5433/ruvee
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
READINESS_DB_TIMEOUT_MS=2000
# OPAQUE server setup file (INV-21). Create it once with:
#   pnpm --filter @ruvee/api build && pnpm --filter @ruvee/api admin opaque-setup --out ../../.secrets/opaque-server-setup
# The path is relative to apps/api when the API runs there. Never commit or share the file.
OPAQUE_SERVER_SETUP_FILE=../../.secrets/opaque-server-setup
# The one origin that serves the web app and the API (same-origin). Must match the browser URL.
PUBLIC_ORIGIN=http://127.0.0.1:3100
# Loopback HTTP development only: drops Secure and the __Host- prefix. Refused in production.
SESSION_COOKIE_SECURE=false
# Browser extension origins allowed to log in and refresh tokens, comma-separated. Empty: none.
# The development build's fixed id is in apps/extension/README.md.
EXTENSION_ORIGINS=
# age X25519 recipient (public key only, age1…) that `ruvee-admin backup` encrypts to (D-29).
# The identity that decrypts is never configured here: keep it offline (docs/guides/server-backup-restore.md).
BACKUP_AGE_RECIPIENT=
