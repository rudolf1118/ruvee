{
  "name": "@ruvee/vault",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "The Ruvee vault engine shared by the web app and the browser extension.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ruvee/contracts": "workspace:*",
    "@ruvee/crypto": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ruvee/eslint-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
