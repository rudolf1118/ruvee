{
  "name": "@ruvee/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Zod schemas for the implemented Ruvee API, shared by the server and clients.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:write": "tsc -p tsconfig.build.json && node scripts/write-openapi.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ruvee/eslint-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
