    },
    "headers": {
      "X-Request-Id": {
        "description": "The request id, as echoed or generated by the server.",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        }
      },
      "Cache-Control": {
        "description": "API responses are never cached.",
        "required": true,
        "schema": {
