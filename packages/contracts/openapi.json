          },
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "requestId"
        ],
        "additionalProperties": false
      },
      "ErrorInternalError": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "const": 500
          },
          "error": {
            "type": "string",
