# Production-shaped server for the static export and the same-origin API.
# Next.js `headers()` is not applied to `output: 'export'`; the security headers come from a
# snippet generated by the web build (apps/web/scripts/write-caddy-headers.mjs) from the exported
# HTML and apps/web/security-headers.ts. If the snippet is missing, `import` fails and Caddy does
# not start: there is no fallback to an empty or default policy (predeployment-review R10).
#
# After `pnpm --filter @ruvee/web build` (which writes apps/web/out-caddy/security-headers.caddy):
#   caddy run --config deploy/Caddyfile
#
# Environment (optional; defaults shown): RUVEE_SITE_ADDRESS (http://127.0.0.1:3101),
# RUVEE_WEB_ROOT (apps/web), RUVEE_API_UPSTREAM (127.0.0.1:4000).
#
# HSTS is omitted here (local HTTP). Public HTTPS must add:
#   header Strict-Transport-Security "max-age=31536000; includeSubDomains"
#
# The API is served from the same origin under /api/ (api-design.md §Conventions).

{
	admin off
}

{$RUVEE_SITE_ADDRESS:http://127.0.0.1:3101} {
	import {$RUVEE_WEB_ROOT:apps/web}/out-caddy/security-headers.caddy site

	# Caddy's path matchers are case-insensitive; the API routes only exact, lower-case paths
	# (review R1). Any other spelling of /api is refused here too, before it reaches the API.
	@apiSpelling {
		path_regexp ^/[Aa][Pp][Ii](/|$)
		not path_regexp ^/api/
	}
	handle @apiSpelling {
		error 404
	}

	# Exclusive handle blocks: try_files must never rewrite an API path to a static file.
	handle /api/* {
		reverse_proxy {$RUVEE_API_UPSTREAM:127.0.0.1:4000}
	}

	handle {
		root * {$RUVEE_WEB_ROOT:apps/web}/out
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Unknown paths are real 404s, with the export's 404 page. Caddy resets response headers
	# before handling an error, so the same snippet is applied again here.
	handle_errors {
		import {$RUVEE_WEB_ROOT:apps/web}/out-caddy/security-headers.caddy errors
		root * {$RUVEE_WEB_ROOT:apps/web}/out
		rewrite * /404.html
		file_server
	}
}
