# /etc/ruvee/api.env: the API's environment for ruvee-api.service. Owner root, mode 0600.
# Synthetic rehearsal only (docs/guides/private-rehearsal.md). Placeholders are <like-this>;
# the passwords are generated on the host (guide §4) and never pasted anywhere else.
# OPAQUE_SERVER_SETUP_FILE is set by the unit (LoadCredential); do not set it here.

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=4000
# The runtime role only (docs/guides/database-roles.md). The database name must stay
# ruvee_e2e_<hex>: backups refuse any other name until real data is allowed (D-19, D-30).
DATABASE_URL=postgresql://ruvee_runtime:<runtime-password>@127.0.0.1:5432/ruvee_e2e_<hex>
LOG_LEVEL=info
READINESS_DB_TIMEOUT_MS=2000
# Exactly the origin the browser shows, https only.
PUBLIC_ORIGIN=https://<rehearsal-host-name>
SESSION_COOKIE_SECURE=true
# Caddy connects from loopback; without this every client shares Caddy's address and its limits
# (review R17).
TRUSTED_PROXY_ADDRESS=127.0.0.1
# The development extension's fixed id (apps/extension/README.md).
EXTENSION_ORIGINS=chrome-extension://ikjjmgfofphmclnkphkceboclijkfkbd
