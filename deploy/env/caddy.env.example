# /etc/ruvee/caddy.env: Caddy's environment for ruvee-caddy.service. Owner root, mode 0644
# (nothing secret). Guide: docs/guides/private-rehearsal.md.

# The same origin as the API's PUBLIC_ORIGIN. An https:// address makes Caddy obtain the
# certificate (for a *.ts.net name, from tailscaled) and send HSTS.
RUVEE_SITE_ADDRESS=https://<rehearsal-host-name>
# The directory holding out/ and out-caddy/ of one build.
RUVEE_WEB_ROOT=/opt/ruvee/current/apps/web
RUVEE_API_UPSTREAM=127.0.0.1:4000
