# /etc/ruvee/operator.env: ruvee-admin's environment (deploy/bin/ruvee-admin). Owner ruvee-ops,
# mode 0400. Read as shell assignments: generated passwords are hex, so no quoting is needed.
# Never the API's file: the API's role cannot run any of these commands.

RUVEE_ADMIN_DATABASE_URL=postgresql://ruvee_operator:<operator-password>@127.0.0.1:5432/ruvee_e2e_<hex>
RUVEE_RUNTIME_ROLE=ruvee_runtime
# The age recipient (public key) backups are encrypted to; the identity stays offline.
BACKUP_AGE_RECIPIENT=age1<recipient>
# pg_dump and pg_restore of the server's major version.
RUVEE_PG_BIN=/usr/lib/postgresql/18/bin
