# Caddy in front of the Ruvee API: the web export, its generated headers and /api/ (deploy/Caddyfile).
# Guide: docs/guides/private-rehearsal.md. Install as /etc/systemd/system/ruvee-caddy.service.
#
# Use this unit instead of the Caddy package's own caddy.service (disable that one): the Caddyfile
# turns Caddy's admin endpoint off, so the package unit's `caddy reload` cannot work. A new
# release is served with `systemctl restart ruvee-caddy`.
#
# Configuration: /etc/ruvee/caddy.env (deploy/env/caddy.env.example). Certificates and Caddy's
# state live in /var/lib/ruvee-caddy.

[Unit]
Description=Caddy for Ruvee
After=network-online.target ruvee-api.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=caddy
Group=caddy
EnvironmentFile=/etc/ruvee/caddy.env
StateDirectory=ruvee-caddy
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/ruvee-caddy XDG_CONFIG_HOME=/var/lib/ruvee-caddy
ExecStartPre=/usr/bin/caddy validate --config /opt/ruvee/current/deploy/Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /opt/ruvee/current/deploy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=5s
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal

MemoryMax=512M
TasksMax=256

# Ports 80 and 443 only.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
